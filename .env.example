# Where CVs and your profile are stored (default: ./data)
DATA_DIR=./data

# Language model (it never receives your contact details)
# LLM_MODELS: the models you can pick in the app, comma-separated "id tier name"; the first is the default.
#   tier = rough cost of one run: $ under 1 cent, $$ 1-5 cents, $$$ over 5 cents. The name is optional.
# OpenRouter (many vendors, one key; requests only go to providers that keep no data):
#   LLM_PROVIDER=openrouter, LLM_API_KEY=<key>
#   LLM_MODELS="deepseek/deepseek-v4.1-flash $ DeepSeek V4.1 Flash, anthropic/claude-haiku-5.5 $ Claude Haiku 5.5, anthropic/claude-sonnet-5.5 $$$ Claude Sonnet 5.5"
# Claude:          LLM_PROVIDER=anthropic, LLM_API_KEY=sk-ant-..., LLM_MODELS="claude-opus-5-5 $$$ Claude Opus 5.5"
# Ollama (local):  LLM_PROVIDER=openai-compatible, LLM_BASE_URL=http://localhost:11434/v1, LLM_MODELS="<model> $"
LLM_PROVIDER=openrouter
LLM_MODELS="deepseek/deepseek-v4.1-flash $ DeepSeek V4.1 Flash, anthropic/claude-haiku-5.5 $ Claude Haiku 5.5, anthropic/claude-sonnet-5.5 $$$ Claude Sonnet 5.5"
LLM_API_KEY=
LLM_BASE_URL=
