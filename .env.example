# Where CVs and your profile are stored (default: ./data)
DATA_DIR=./data

# Language model (only used for import/tailoring; it never receives your contact details)
# Claude:            LLM_PROVIDER=anthropic, LLM_MODEL=claude-opus-5-5, LLM_API_KEY=sk-ant-...
# OpenRouter:        LLM_PROVIDER=openai-compatible, LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_MODEL=<model>, LLM_API_KEY=<key>
# Ollama (local):    LLM_PROVIDER=openai-compatible, LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=<model>
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_BASE_URL=
